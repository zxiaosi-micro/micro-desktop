{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "micro-desktop",
  "version": "0.1.0",
  "identifier": "com.micro.desktop",
  "build": {
    "frontendDist": "../../micro-web/apps/admin/dist",
    "devUrl": "http://127.0.0.1:5173",
    "beforeDevCommand": "cd ../../micro-web && pnpm --filter admin dev",
    "beforeBuildCommand": "cd ../../micro-web && pnpm --filter admin build"
  },
  "app": {
    "windows": [
      {
        "title": "运维 PC · micro",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"]
  }
}
